{
  "expo": {
    "name": "Vault",
    "slug": "vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Vault.png",
    "scheme": "player",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e293b",
        "foregroundImage": "./assets/images/Vault.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.adnane46.vault"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e293b",
          "dark": {
            "backgroundColor": "#1e293b"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "videoPermission": false,
          "audioPermission": "Allow $(PRODUCT_NAME) to access your audio files to play music."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
